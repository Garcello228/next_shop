generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  name      String
  contact   String   @unique
  Pasword   String
  email     String?   @unique
  LastName  String?
  Address   String?
  Wishlist  WishlistItem[]
  Cart      CartItem[]
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  @@unique([userId, productId]) 
}

model CartItem {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  @@unique([userId, productId]) 
}

model Usermessage {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  name      String
  email     String   
  phone     String  
  message   String
}


model Product{
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  name String
  category String
  discountPrice Int?
  Price Int?
  grade String
  reviews Int
  discount Int?
  new String?
  img String
  description String
  color         ProductColor?
  wishlistItems WishlistItem[]
  CartItem CartItem[]
  OrderItems    OrderItem[]
}

model ProductColor {
  id        Int  @id @default(autoincrement())
  one       String
  two       String
  product   Product @relation(fields: [productId], references: [id])
  productId Int  @unique 
}

model Coupon {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  name      String
}


model Orders {
  id           Int         @id @default(autoincrement())
  createdAt    DateTime    @default(now())
  

  name         String     
  company      String?    
  address      String     
  optional     String?     
  city         String      
  phone        String      
  email        String      
  
  total        Int      
  
  orderItems   OrderItem[]
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  
 
  order         Orders    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       Int
  
 
  product       Product  @relation(fields: [productId], references: [id])
  productId     Int
  
  quantity      Int     
}

model Order {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())

  name          String
  company       String?
  address       String
  optional      String?
  city          String
  phone         String
  email         String
  total         Int      

  title         String
  img           String
  color         String
  size          String
  quantity      Int
  price         Int? 
  discountPrice Int? 
}




